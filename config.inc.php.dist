<?php

// Everything not set here falls back to the built-in defaults in
// config.inc.default.php (versioned with the plugin, no need to copy those
// over) - this file only needs what's specific to YOUR install: secrets and
// per-domain overrides.

// Reference address only; no longer used for automatic admin notifications
// (see README.md: "What this adaptation deliberately does NOT have").
$config['pr_admin_email'] = 'postmaster@your.domain.com';

// Sender / reply-to for the confirmation-code emails.
$config['pr_replyto_email'] = 'postmaster@your.domain.com';

// Shared SMTP relay used to send confirmation-code emails, for every domain
// that doesn't override 'smtp_server' in pr_domains below.
$config['pr_default_smtp_server'] = 'ssl://smtp.your.domain.com:465';

// --- Multi-domain configuration -------------------------------------------
//
// One entry per mail domain this install serves. Only postmaster@<domain>
// has the vpopmaild privilege to reset another mailbox's password, so that
// admin username is always derived automatically - only its password needs
// to be configured here.
//
// For SMTP (sending the confirmation code), by default each domain
// authenticates as its own postmaster@<domain> reusing the SAME password
// (vpopmail shares one password across IMAP/POP/SMTP-AUTH for a mailbox).
// Override per domain only when that doesn't apply:
//   'smtp_user' / 'smtp_pass' - use a different, dedicated sending account
//   'smtp_auth' => false      - this domain's relay accepts mail unauthenticated
//   'smtp_server'             - this domain's relay is a different host
//   'from'                    - override the From/Reply-To address (default:
//                                pr_replyto_email, EXCEPT when smtp_auth is
//                                false, where it defaults to noreply@<domain>
//                                instead - an unauthenticated relay commonly
//                                only accepts mail FROM its own domain)
//
// See README.md, "Multi-domain configuration", for the full precedence order.
$config['pr_domains'] = [
    'your.domain.com' => [
        'vpopmaild_admin_pass' => 'CHANGEME',
    ],
    // 'other.domain.com' => [
    //     'vpopmaild_admin_pass' => 'CHANGEME',
    //     'smtp_auth' => false, // From defaults to noreply@other.domain.com
    // ],
    // 'third.domain.com' => [
    //     'vpopmaild_admin_pass' => 'CHANGEME',
    //     'smtp_user'   => 'alerts@thirdparty.example',
    //     'smtp_pass'   => 'CHANGEME',
    //     'smtp_server' => 'smtp.thirdparty.example:587',
    // ],
];

// --- Single-domain / legacy shorthand --------------------------------------
//
// Equivalent to a single pr_domains entry above; kept for installs that
// don't need multiple domains and prefer not to use the array form. If a
// domain isn't listed in pr_domains at all, these are used as the fallback.
// $config['pr_vpopmaild_admin_pass'] = 'CHANGEME';
// $config['pr_default_smtp_user']    = 'noreply@your.domain.com';
// $config['pr_default_smtp_pass']    = 'CHANGEME';

// --- SQL driver (advanced, opt-in) -----------------------------------------
//
// Only needed if you set pr_password_driver = 'sql' (default is 'vpopmaild').
// Scales to hundreds of domains with ONE set of credentials instead of a
// postmaster password per domain, but requires vpopmail itself to run on a
// SQL backend, and the hash scheme MUST be validated against your specific
// vpopmail install first - see README.md, "SQL driver".
// Same DSN format as Roundcube's own db_dsnw (this reuses rcube_db, just
// pointed at vpopmail's database instead of Roundcube's own).
// $config['pr_password_driver'] = 'sql';
// $config['pr_sql_dsn'] = 'mysql://vpopmail_admin:CHANGEME@127.0.0.1/vpopmail';

?>
